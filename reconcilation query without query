
WITH COA_ALL_LEVELS AS (
    SELECT
        COA_ID,
        PARENT_ID,
        GL_CODE,
        ACCOUNT_TITLE,
        STATUS,
        REFERENCE_CODE,
        CASE
            WHEN LENGTH(GL_CODE) = 1 THEN 1
            WHEN LENGTH(GL_CODE) = 3 THEN 2
            WHEN LENGTH(GL_CODE) = 6 THEN 3
            WHEN LENGTH(GL_CODE) = 10 THEN 4
            WHEN LENGTH(GL_CODE) = 15 THEN 5
        END AS ACCOUNT_LEVEL
    FROM AB_FIN_COA
    WHERE
        STATUS = 'Y'
        AND LENGTH(GL_CODE) IN (1, 3, 6, 10, 15)
        AND (ORG_ID=:GV_ORG_ID OR :GV_ORG_ID=1006)
    ORDER BY COA_ID ASC
),
PARENT_ACCOUNTS AS (
    SELECT DISTINCT
        PARENT_ID,
        CASE
            WHEN PARENT_ID IN (SELECT COA_ID FROM COA_ALL_LEVELS WHERE ACCOUNT_LEVEL = 1) THEN 1
            WHEN PARENT_ID IN (SELECT COA_ID FROM COA_ALL_LEVELS WHERE ACCOUNT_LEVEL = 2) THEN 2
            WHEN PARENT_ID IN (SELECT COA_ID FROM COA_ALL_LEVELS WHERE ACCOUNT_LEVEL = 3) THEN 3
            WHEN PARENT_ID IN (SELECT COA_ID FROM COA_ALL_LEVELS WHERE ACCOUNT_LEVEL = 4) THEN 4
        END AS PARENT_LEVEL
    FROM COA_ALL_LEVELS
    WHERE PARENT_ID IS NOT NULL
),
ACCOUNT_HIERARCHY AS (
    SELECT
        L1.COA_ID AS LEVEL1_ID,
        L2.COA_ID AS LEVEL2_ID,
        L3.COA_ID AS LEVEL3_ID,
        L4.COA_ID AS LEVEL4_ID,
        L5.COA_ID AS LEVEL5_ID,
        L1.ACCOUNT_TITLE AS LEVEL1_TITLE,
        L2.ACCOUNT_TITLE AS LEVEL2_TITLE,
        L3.ACCOUNT_TITLE AS LEVEL3_TITLE,
        L4.ACCOUNT_TITLE AS LEVEL4_TITLE,
        L5.ACCOUNT_TITLE AS LEVEL5_TITLE,
        L1.GL_CODE AS LEVEL1_GL_CODE,
        L2.GL_CODE AS LEVEL2_GL_CODE,
        L3.GL_CODE AS LEVEL3_GL_CODE,
        L4.GL_CODE AS LEVEL4_GL_CODE,
        L5.GL_CODE AS LEVEL5_GL_CODE,
        L1.REFERENCE_CODE AS LEVEL1_REF,
        L2.REFERENCE_CODE AS LEVEL2_REF,
        L3.REFERENCE_CODE AS LEVEL3_REF,
        L4.REFERENCE_CODE AS LEVEL4_REF,
        L5.REFERENCE_CODE AS LEVEL5_REF,
        COALESCE(L5.COA_ID, L4.COA_ID, L3.COA_ID, L2.COA_ID, L1.COA_ID) AS ACTUAL_ACCOUNT_ID
    FROM COA_ALL_LEVELS L1
    LEFT JOIN COA_ALL_LEVELS L2 ON L2.PARENT_ID = L1.COA_ID AND L2.ACCOUNT_LEVEL = 2
    LEFT JOIN COA_ALL_LEVELS L3 ON L3.PARENT_ID = L2.COA_ID AND L3.ACCOUNT_LEVEL = 3
    LEFT JOIN COA_ALL_LEVELS L4 ON L4.PARENT_ID = L3.COA_ID AND L4.ACCOUNT_LEVEL = 4
    LEFT JOIN COA_ALL_LEVELS L5 ON L5.PARENT_ID = L4.COA_ID AND L5.ACCOUNT_LEVEL = 5
    WHERE L1.ACCOUNT_LEVEL = 1
),
USER_APPROVAL AS (
    SELECT APP_IDS AS APP_ID
    FROM AB_USER_ACTION_APPROVAL
    WHERE APP_TYPE = '780'
      AND STATUS = 'Y'
      AND APPROVAL_STATUS = 'APPROVED'
      AND ORG_ID = :GV_ORG_ID
),
ACCOUNT_TITLE AS (
    SELECT TRD.COA_IDD AS ACCOUNT_ID
    FROM AB_FIN_TRANSACTION TR
    JOIN AB_FIN_TRANSACTION_DET TRD ON TRD.TR_ID = TR.TR_ID AND TRD.STATUS = 'Y'
    WHERE TR.ORG_ID = :GV_ORG_ID
      AND TR.VOUCHER_NAME IS NOT NULL
      AND TR.STATUS = 'Y'
    GROUP BY TRD.COA_IDD
),
DEBIT_ACCOUNT AS (
    SELECT
        TR.TR_ID VOUCHER_NO,
        TRD.COA_IDD AS ACCOUNT_ID,
        TRD.TRD_DATE VOUCHER_DATE,
        NVL(SUM(DR_AMOUNT), 0) AS DEBIT_AMOUNT
    FROM AB_FIN_TRANSACTION TR
    JOIN AB_FIN_TRANSACTION_DET TRD ON TRD.TR_ID = TR.TR_ID AND TRD.STATUS = 'Y'
    JOIN USER_APPROVAL UA ON UA.APP_ID = NVL(TR.TR_ID, TRD.TRD_ID)
    JOIN AB_FIN_COA COA ON COA.COA_ID = TRD.COA_IDD AND COA.STATUS = 'Y'
    WHERE TR.ORG_ID = :GV_ORG_ID
      AND TR.VOUCHER_NAME IS NOT NULL
      AND TR.STATUS = 'Y'
      AND CR_AMOUNT IS NULL
    GROUP BY TR.TR_ID, TRD.COA_IDD, TRD.TRD_DATE
),
CREDIT_ACCOUNT AS (
    SELECT
        TR.TR_ID VOUCHER_NO,
        TRD.COA_IDD AS ACCOUNT_ID,
        TRD.TRD_DATE VOUCHER_DATE,
        NVL(SUM(CR_AMOUNT), 0) AS CREDIT_AMOUNT
    FROM AB_FIN_TRANSACTION TR
    JOIN AB_FIN_TRANSACTION_DET TRD ON TRD.TR_ID = TR.TR_ID AND TRD.STATUS = 'Y'
    JOIN USER_APPROVAL UA ON UA.APP_ID = NVL(TR.TR_ID, TRD.TRD_ID)
    JOIN AB_FIN_COA COA ON COA.COA_ID = TRD.COA_IDD AND COA.STATUS = 'Y'
    WHERE TR.ORG_ID = :GV_ORG_ID
      AND TR.VOUCHER_NAME IS NOT NULL
      AND TR.STATUS = 'Y'
      AND DR_AMOUNT IS NULL
    GROUP BY TR.TR_ID, TRD.COA_IDD, TRD.TRD_DATE
),
BEFORE_OPENING_BALANCE AS (
    SELECT
        ACCOUNT_ID,
        NVL(SUM(OPENING_DEBIT),0) AS OPENING_DEBIT,
        NVL(SUM(OPENING_CREDIT),0) AS OPENING_CREDIT
    FROM (
        SELECT ACCOUNT_ID, NVL(SUM(DEBIT_AMOUNT),0) AS OPENING_DEBIT, NULL AS OPENING_CREDIT
        FROM DEBIT_ACCOUNT
        WHERE TRUNC(VOUCHER_DATE) < NVL(TO_DATE(:P972_FROM_DATE,'DD-MON-YYYY'),TRUNC(VOUCHER_DATE))
        GROUP BY ACCOUNT_ID
        UNION ALL
        SELECT ACCOUNT_ID, NULL AS OPENING_DEBIT, NVL(SUM(CREDIT_AMOUNT),0) AS OPENING_CREDIT
        FROM CREDIT_ACCOUNT
        WHERE TRUNC(VOUCHER_DATE) < NVL(TO_DATE(:P972_FROM_DATE,'DD-MON-YYYY'),TRUNC(VOUCHER_DATE))
        GROUP BY ACCOUNT_ID
    )
    GROUP BY ACCOUNT_ID
),
BETWEEN_TRANSACTIONS AS (
    SELECT
        ACCOUNT_ID,
        NVL(SUM(PERIOD_DEBIT),0) AS PERIOD_DEBIT,
        NVL(SUM(PERIOD_CREDIT),0) AS PERIOD_CREDIT
    FROM (
        SELECT ACCOUNT_ID, NVL(SUM(DEBIT_AMOUNT),0) AS PERIOD_DEBIT, NULL AS PERIOD_CREDIT
        FROM DEBIT_ACCOUNT
        WHERE TRUNC(VOUCHER_DATE) BETWEEN NVL(TO_DATE(:P972_FROM_DATE,'DD-MON-YYYY'),TRUNC(VOUCHER_DATE))
                                       AND NVL(TO_DATE(:P972_TO_DATE,'DD-MON-YYYY'),TRUNC(VOUCHER_DATE))
        GROUP BY ACCOUNT_ID
        UNION ALL
        SELECT ACCOUNT_ID, NULL AS PERIOD_DEBIT, NVL(SUM(CREDIT_AMOUNT),0) AS PERIOD_CREDIT
        FROM CREDIT_ACCOUNT
        WHERE TRUNC(VOUCHER_DATE) BETWEEN NVL(TO_DATE(:P972_FROM_DATE,'DD-MON-YYYY'),TRUNC(VOUCHER_DATE))
                                       AND NVL(TO_DATE(:P972_TO_DATE,'DD-MON-YYYY'),TRUNC(VOUCHER_DATE))
        GROUP BY ACCOUNT_ID
    )
    GROUP BY ACCOUNT_ID
),
ACCOUNT_TOTALS AS (
    SELECT
        AC.ACCOUNT_ID,
        NVL(OB.OPENING_DEBIT,0) AS TOTAL_OPENING_DEBIT,
        NVL(OB.OPENING_CREDIT,0) AS TOTAL_OPENING_CREDIT,
        NVL(BT.PERIOD_DEBIT,0) AS TOTAL_PERIOD_DEBIT,
        NVL(BT.PERIOD_CREDIT,0) AS TOTAL_PERIOD_CREDIT
    FROM ACCOUNT_TITLE AC
    LEFT JOIN BEFORE_OPENING_BALANCE OB ON OB.ACCOUNT_ID = AC.ACCOUNT_ID
    LEFT JOIN BETWEEN_TRANSACTIONS BT ON BT.ACCOUNT_ID = AC.ACCOUNT_ID
),
LEVEL_TOTALS AS (
    SELECT
        1 AS DISPLAY_LEVEL,
        AH.LEVEL1_ID AS ACCOUNT_ID,
        AH.LEVEL1_GL_CODE AS GL_CODE,
        AH.LEVEL1_TITLE AS ACCOUNT_TITLE,
        AH.LEVEL1_REF AS REFERENCE_CODE,
        SUM(NVL(AT.TOTAL_OPENING_DEBIT,0)) AS OPENING_DEBIT,
        SUM(NVL(AT.TOTAL_OPENING_CREDIT,0)) AS OPENING_CREDIT,
        SUM(NVL(AT.TOTAL_PERIOD_DEBIT,0)) AS CURRENT_DEBIT,
        SUM(NVL(AT.TOTAL_PERIOD_CREDIT,0)) AS CURRENT_CREDIT
    FROM ACCOUNT_HIERARCHY AH
    LEFT JOIN ACCOUNT_TOTALS AT ON AT.ACCOUNT_ID = AH.ACTUAL_ACCOUNT_ID
    GROUP BY AH.LEVEL1_ID, AH.LEVEL1_GL_CODE, AH.LEVEL1_TITLE, AH.LEVEL1_REF

    UNION ALL

    SELECT
        2 AS DISPLAY_LEVEL,
        AH.LEVEL2_ID AS ACCOUNT_ID,
        AH.LEVEL2_GL_CODE AS GL_CODE,
        AH.LEVEL2_TITLE AS ACCOUNT_TITLE,
        AH.LEVEL2_REF AS REFERENCE_CODE,
        SUM(NVL(AT.TOTAL_OPENING_DEBIT,0)) AS OPENING_DEBIT,
        SUM(NVL(AT.TOTAL_OPENING_CREDIT,0)) AS OPENING_CREDIT,
        SUM(NVL(AT.TOTAL_PERIOD_DEBIT,0)) AS CURRENT_DEBIT,
        SUM(NVL(AT.TOTAL_PERIOD_CREDIT,0)) AS CURRENT_CREDIT
    FROM ACCOUNT_HIERARCHY AH
    LEFT JOIN ACCOUNT_TOTALS AT ON AT.ACCOUNT_ID = AH.ACTUAL_ACCOUNT_ID
    GROUP BY AH.LEVEL2_ID, AH.LEVEL2_GL_CODE, AH.LEVEL2_TITLE, AH.LEVEL2_REF

    UNION ALL

    SELECT
        3 AS DISPLAY_LEVEL,
        AH.LEVEL3_ID AS ACCOUNT_ID,
        AH.LEVEL3_GL_CODE AS GL_CODE,
        AH.LEVEL3_TITLE AS ACCOUNT_TITLE,
        AH.LEVEL3_REF AS REFERENCE_CODE,
        SUM(NVL(AT.TOTAL_OPENING_DEBIT,0)) AS OPENING_DEBIT,
        SUM(NVL(AT.TOTAL_OPENING_CREDIT,0)) AS OPENING_CREDIT,
        SUM(NVL(AT.TOTAL_PERIOD_DEBIT,0)) AS CURRENT_DEBIT,
        SUM(NVL(AT.TOTAL_PERIOD_CREDIT,0)) AS CURRENT_CREDIT
    FROM ACCOUNT_HIERARCHY AH
    LEFT JOIN ACCOUNT_TOTALS AT ON AT.ACCOUNT_ID = AH.ACTUAL_ACCOUNT_ID
    GROUP BY AH.LEVEL3_ID, AH.LEVEL3_GL_CODE, AH.LEVEL3_TITLE, AH.LEVEL3_REF

    UNION ALL

    SELECT
        4 AS DISPLAY_LEVEL,
        AH.LEVEL4_ID AS ACCOUNT_ID,
        AH.LEVEL4_GL_CODE AS GL_CODE,
        AH.LEVEL4_TITLE AS ACCOUNT_TITLE,
        AH.LEVEL4_REF AS REFERENCE_CODE,
        SUM(NVL(AT.TOTAL_OPENING_DEBIT,0)) AS OPENING_DEBIT,
        SUM(NVL(AT.TOTAL_OPENING_CREDIT,0)) AS OPENING_CREDIT,
        SUM(NVL(AT.TOTAL_PERIOD_DEBIT,0)) AS CURRENT_DEBIT,
        SUM(NVL(AT.TOTAL_PERIOD_CREDIT,0)) AS CURRENT_CREDIT
    FROM ACCOUNT_HIERARCHY AH
    LEFT JOIN ACCOUNT_TOTALS AT ON AT.ACCOUNT_ID = AH.ACTUAL_ACCOUNT_ID
    GROUP BY AH.LEVEL4_ID, AH.LEVEL4_GL_CODE, AH.LEVEL4_TITLE, AH.LEVEL4_REF

    UNION ALL

    SELECT
        5 AS DISPLAY_LEVEL,
        AH.LEVEL5_ID AS ACCOUNT_ID,
        AH.LEVEL5_GL_CODE AS GL_CODE,
        AH.LEVEL5_TITLE AS ACCOUNT_TITLE,
        AH.LEVEL5_REF AS REFERENCE_CODE,
        SUM(NVL(AT.TOTAL_OPENING_DEBIT,0)) AS OPENING_DEBIT,
        SUM(NVL(AT.TOTAL_OPENING_CREDIT,0)) AS OPENING_CREDIT,
        SUM(NVL(AT.TOTAL_PERIOD_DEBIT,0)) AS CURRENT_DEBIT,
        SUM(NVL(AT.TOTAL_PERIOD_CREDIT,0)) AS CURRENT_CREDIT
    FROM ACCOUNT_HIERARCHY AH
    LEFT JOIN ACCOUNT_TOTALS AT ON AT.ACCOUNT_ID = AH.LEVEL5_ID
    WHERE (TOTAL_OPENING_DEBIT !=0 OR TOTAL_OPENING_CREDIT !=0 OR TOTAL_PERIOD_DEBIT !=0 OR TOTAL_PERIOD_CREDIT !=0)
    GROUP BY AH.LEVEL5_ID, AH.LEVEL5_GL_CODE, AH.LEVEL5_TITLE, AH.LEVEL5_REF
)
SELECT
    DISPLAY_LEVEL,
    ACCOUNT_ID,
    ACCOUNT_TITLE || ' - ' || GL_CODE AS ACCOUNT_TITLE,
    REFERENCE_CODE,
    NVL(OPENING_DEBIT,0) AS OPENING_DEBIT,
    NVL(OPENING_CREDIT,0) AS OPENING_CREDIT,
    NVL(CURRENT_DEBIT,0) AS CURRENT_DEBIT,
    NVL(CURRENT_CREDIT,0) AS CURRENT_CREDIT,
    (NVL(OPENING_DEBIT,0) + NVL(CURRENT_DEBIT,0)) AS CLOSING_DEBIT,
    (NVL(OPENING_CREDIT,0) + NVL(CURRENT_CREDIT,0)) AS CLOSING_CREDIT,
    (NVL(OPENING_DEBIT,0) + NVL(CURRENT_DEBIT,0)) - (NVL(OPENING_CREDIT,0) + NVL(CURRENT_CREDIT,0)) AS NET_BALANCE
FROM LEVEL_TOTALS
WHERE ACCOUNT_ID IS NOT NULL
AND REFERENCE_CODE = NVL(:P972_REF_CODE,REFERENCE_CODE)
ORDER BY ACCOUNT_ID ASC

